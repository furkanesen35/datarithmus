# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/datarithmus?schema=public"

# Generate this value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-secret"

# Google OAuth credentials; use the same client ID for both ID variables
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Optional application URL and default enrollment meeting link
BASE_URL="http://localhost:3000"
GOOGLE_MEET_LINK=""

# SMTP settings for email and meeting invitations
SMTP_HOST="smtp.gmail.com"
SMTP_USER=""
SMTP_PASS=""
