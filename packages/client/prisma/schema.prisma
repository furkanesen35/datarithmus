model EnrollmentApplication {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  course    String
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique
  password                String
  username                String
  isSuperuser             Boolean                  @default(false)
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  emailVerificationTokens EmailVerificationToken[]
  meetingParticipants     MeetingParticipant[]
  passwordResetTokens     PasswordResetToken[]
  questionResults         QuestionResult[]
  quizResults             QuizResults[]
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  videoUrl    String
  createdAt   DateTime @default(now())
}

model Quiz {
  id          Int            @id @default(autoincrement())
  title       String
  createdAt   DateTime       @default(now())
  questions   QuizQuestion[]
  questionResults QuestionResult[]
  quizResults QuizResults[]
  passingScore Int @default(50)
}

model QuizQuestion {
  id            Int          @id @default(autoincrement())
  question      String
  options       String
  correctAnswer Int
  quizId        Int
  createdAt     DateTime     @default(now())
  quiz          Quiz         @relation(fields: [quizId], references: [id])
  questionResults   QuestionResult[]
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Homework {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  dueDate     DateTime
  filePath    String?
  createdAt   DateTime @default(now())
}

model Resource {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  filePath  String?
  link      String?
  createdAt DateTime @default(now())
}

model Schedule {
  id             Int                  @id @default(autoincrement())
  title          String
  start          DateTime
  end            DateTime
  description    String?
  createdAt      DateTime             @default(now())
  googleMeetLink String?
  status         String               @default("pending")
  participants   MeetingParticipant[]
}

model MeetingParticipant {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  userId     Int
  createdAt  DateTime @default(now())
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@unique([scheduleId, userId])
}

model StudentProgress {
  id                Int      @id @default(autoincrement())
  studentEmail      String
  homeworkCompleted Int      @default(0)
  quizScore         Int      @default(0)
  notes             String?
  createdAt         DateTime @default(now())
}

model Discussion {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  author    String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Feedback {
  id        Int      @id @default(autoincrement())
  question  String
  scale     Int
  createdAt DateTime @default(now())
}

model Student {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  name        String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
}

model QuestionResult {
  id         Int          @id @default(autoincrement())
  userId     Int
  quizId     Int
  questionId Int
  answer     Int
  isCorrect  Boolean
  createdAt  DateTime     @default(now())
  question   QuizQuestion @relation(fields: [questionId], references: [id])
  quiz       Quiz         @relation(fields: [quizId], references: [id])
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizResults {
  id          Int      @id @default(autoincrement())
  studentId   Int
  quizId      Int
  answers     Json     // Stores all answers for the quiz
  score       Int
  submittedAt DateTime @default(now())
  student     User     @relation(fields: [studentId], references: [id])
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  @@unique([studentId, quizId]) // One result per student per quiz
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppointmentRequest {
  id           Int      @id @default(autoincrement())
  studentEmail String
  adminEmail   String
  date         String
  time         String
  message      String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
}
